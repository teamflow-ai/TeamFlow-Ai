#!/bin/sh
# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
#
# Required ENV vars:
# ------------------
#   JAVA_HOME - location of a JDK home dir
# ----------------------------------------------------------------------------

set -euf
[ "${MVNW_VERBOSE-}" != debug ] || set -x

# OS specific support.
native_path() { printf %s\\n "$1"; }
case "$(uname)" in
CYGWIN* | MINGW*)
  [ -z "${JAVA_HOME-}" ] || JAVA_HOME="$(cygpath --unix "$JAVA_HOME")"
  native_path() { cygpath --path --windows "$1"; }
  ;;
esac

# Extension to use for the wrapper jar
WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES=".mvn/wrapper/maven-wrapper.properties"
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

BASE_DIR=$(dirname "$0")

if [ ! -f "$BASE_DIR/$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper jar..."
  WRAPPER_URL=$(grep '^wrapperUrl=' "$BASE_DIR/$WRAPPER_PROPERTIES" | cut -d= -f2-)
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$BASE_DIR/$WRAPPER_JAR" "$WRAPPER_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$BASE_DIR/$WRAPPER_JAR" "$WRAPPER_URL"
  else
    echo "Error: curl or wget is required to download the Maven Wrapper jar." >&2
    exit 1
  fi
fi

if [ -z "${JAVA_HOME-}" ]; then
  JAVACMD="$(command -v java || true)"
else
  JAVACMD="$JAVA_HOME/bin/java"
fi

if [ ! -x "$JAVACMD" ]; then
  echo "Error: JAVA_HOME is not set correctly or 'java' is not on the PATH." >&2
  exit 1
fi

exec "$JAVACMD" \
  -classpath "$(native_path "$BASE_DIR/$WRAPPER_JAR")" \
  "-Dmaven.multiModuleProjectDirectory=$(native_path "$BASE_DIR")" \
  "$WRAPPER_LAUNCHER" "$@"
