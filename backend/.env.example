# Copy to .env before running docker compose:  cp .env.example .env
#
# TEAMFLOW_JWT_SECRET has no default anywhere in the stack. Services fail fast
# at startup without it, rather than signing tokens with a value that is
# published in this repository.
#
# Generate a strong one:
#   openssl rand -base64 48

TEAMFLOW_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-secret-material

MYSQL_PASSWORD=teamflow
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# rule-based (default) | spring-ai
TEAMFLOW_AI_PROVIDER=rule-based

TEAMFLOW_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
